<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>gaden_simulation_p</name>
  <version>0.0.0</version>
  <description>This package manages launch and control logic for a multi-robot gas dispersion simulation using Crazyswarm2 for swarm coordination and GADEN for environmental gas modeling.</description>
  <maintainer email="qassimgazi06@gmail.com">qas</maintainer>
  <license>MIT</license>
  
  <!-- Build tools needed to install the python scripts and launch files -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  
  <!-- Python runtime library for ROS 2 -->
  <exec_depend>rclpy</exec_depend>

  <!-- Standard standard message interfaces used in the python scripts -->
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>

  <!-- Transform (TF2) runtime for coordinate frames -->
  <exec_depend>tf2_ros</exec_depend>

  <!-- Custom message interfaces used by the workspace -->
  <exec_depend>olfaction_msgs</exec_depend>
  <exec_depend>crazyflie_interfaces</exec_depend>
  <exec_depend>gaden_simulation_interfaces</exec_depend>

  <!-- Used to execute python launch files -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <!-- Drone package dependencies -->
  <exec_depend>crazyflie</exec_depend>                  <!-- For crazyflie_server.cpp (real) -->
  <exec_depend>crazyflie_sim</exec_depend>              <!-- For crazyflie_server.py (sim) -->
  <exec_depend>crazyflie_py</exec_depend>               <!-- For crazyflie.py (sim/real) -->
  
  <!-- Custom node execution dependencies -->
  <exec_depend>test_env</exec_depend>                   <!-- Runtime env for tests, if relevant -->
  <exec_depend>simulated_gas_sensor</exec_depend>       <!-- For MOX sensor nodes in APF_1_1.py -->
  
  <!-- Standard python module dependencies -->
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <!-- Standard testing dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
